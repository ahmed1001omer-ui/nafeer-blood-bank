{
  "name": "blood-bank-management-system-test",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate-post-responses.cjs && next start",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win --x64",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "security:audit": "node scripts/security-audit/run-audit.cjs"
  },
  "build": {
    "appId": "com.nafeer.bloodbank",
    "productName": "Nafeer Blood Bank Management System",
    "artifactName": "Nafeer-Blood-Bank-Setup-${version}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/nafeer-v2.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام نفير لإدارة بنك الدم"
    },
    "files": [
      "electron/**/*",
      "public/**/*"
    ]
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jose": "^5.9.6",
    "lottie-web": "^5.13.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.19.3",
    "typescript": "5.9.3"
  }
}
